<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title'); ?>
 Danh sách bài viết 

<?php $this->stopSection(); ?>

<?php $this->startSection('content'); ?>
 <div>
 <?php if($message !=''): ?>
 <div style="color: green; font-weight: bold;"><?php echo \htmlentities($message??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php endif; ?>
 <table border="1">
 <tr>
 <th>ID</th>
 <th>Title</th>
 <th>Image</th>
 <th>Category Name</th>
 <th>
 <a href="<?php echo \htmlentities(BASE_URL??'', ENT_QUOTES, 'UTF-8', false); ?>admin/articles/create">Add</a>
 </th>
 
 </tr>
 <?php $__currentLoopData = $articles; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $article): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td><?= $article->id ?></td>
 <td><?= $article->title ?></td>
 <td><img src="<?= BASE_URL . $article->image ?>" alt="" width="100"></td>
 <td><?= $article->name ?></td>
 <td>    
 <a href="<?php echo \htmlentities(BASE_URL . 'admin/articles/edit/' . $article->id??'', ENT_QUOTES, 'UTF-8', false); ?>">Edit</a> |
 <form action="<?php echo \htmlentities(BASE_URL . 'admin/articles/delete/' . 
 $article->id??'', ENT_QUOTES, 'UTF-8', false); ?>" method="post">
 <button type="submit" onclick="return confirm('Bạn có chắc muốn xóa?')">Delete</button>
 </form>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </table>
 </div>

<?php $this->stopSection(); ?>
<?php if (isset($_shouldextend[1])) { echo $this->runChild('admin.dashboard'); } ?>