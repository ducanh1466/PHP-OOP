<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title'); ?>
 Sửa bài viết 

<?php $this->stopSection(); ?>

<?php $this->startSection('content'); ?>
 <form action="" method="post" enctype="multipart/form-data">
 <div class="control">
 <label for="">Title</label>
 <input type="text" name="title" value="<?php echo \htmlentities($post->title??'', ENT_QUOTES, 'UTF-8', false); ?>" id="">
 </div>

 <div class="control">
 <label for="">Image</label>
 <input type="file" name="image" id=""> <br>
 <img src="<?php echo \htmlentities(BASE_URL . $post->image??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="" width="100">

 </div>

 <div class="control"> 
 <label for="">Category</label>
 <select name="category_id" id="">
 <?php $__currentLoopData = $categories; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $cate): $loop = $this->incrementLoopIndices();  ?>
 <option value="<?php echo \htmlentities($cate->id??'', ENT_QUOTES, 'UTF-8', false); ?>"
 <?php if($cate->id == $post->category_id) echo 'selected'; ?>
 ><?php echo \htmlentities($cate->name??'', ENT_QUOTES, 'UTF-8', false); ?></option>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </select>
 </div>

 <div class="control">
 <label for="">Description</label>
 <textarea name="description" id="" cols="30" rows="10"><?php echo \htmlentities($post->description??'', ENT_QUOTES, 'UTF-8', false); ?></textarea>
 </div>

 <div class="control">
 <label for="">Content</label>
 <textarea name="content" id="" cols="30" rows="10"><?php echo \htmlentities($post->content??'', ENT_QUOTES, 'UTF-8', false); ?></textarea>
 </div>

 <div class="control">
 <button type="submit">Update</button>

 </form>

<?php $this->stopSection(); ?>
<?php if (isset($_shouldextend[1])) { echo $this->runChild('admin.dashboard'); } ?>