<?php $this->startSection('content'); ?>
 <form action="" method="post" enctype="multipart/form-data">
 <div class="control">
 <label for="">Title</label>
 <input type="text" name="title" value="<?php echo \htmlentities($posts['title'] ?? ''??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <span style="color: red"><?php echo \htmlentities($error['title'] ?? ''??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 </div>

 <div class="control">
 <label for="">Image</label>
 <input type="file" name="image">
 <span style="color: red"><?php echo \htmlentities($error['image'] ?? ''??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 </div>

 <div class="control"> 
 <label for="">Category</label>
 <select name="category_id" id="">
 <?php $__currentLoopData = $categories; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $cate): $loop = $this->incrementLoopIndices();  ?>
 <?php echo \htmlentities($cate_id = $posts['category_id'] ?? ''??'', ENT_QUOTES, 'UTF-8', false); ?>

 <option 
 value="<?php echo \htmlentities($cate->id??'', ENT_QUOTES, 'UTF-8', false); ?>" 
 <?php if($cate_id == $cate->id) echo 'selected'; ?>>
 <?php echo \htmlentities($cate->name??'', ENT_QUOTES, 'UTF-8', false); ?> 
 </option>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </select>
 </div>

 <div class="control">
 <label for="">Description</label>
 <textarea name="description" id="" cols="30" rows="10"><?php echo \htmlentities($posts['description'] ?? ''??'', ENT_QUOTES, 'UTF-8', false); ?></textarea>
 </div>

 <div class="control">
 <label for="">Content</label>
 <textarea name="content" id="" cols="30" rows="10"><?php echo \htmlentities($posts['content'] ?? ''??'', ENT_QUOTES, 'UTF-8', false); ?></textarea>
 </div>

 <div class="control">
 <button type="submit">Create new</button>

 </form>

